# Copy to .env and fill in once the problem's stack is known:
#   cp .env.example .env
#
# .env is gitignored -- never commit real keys. scripts/setup.sh loads it
# locally with `set -a; source .env; set +a` (see the comment there).
#
# In CI (.github/workflows/ci.yml), add the same names as repository secrets
# (Settings -> Secrets and variables -> Actions) and reference them in the
# `make setup` step, e.g.:
#   env:
#     OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}

ANTHROPIC_API_KEY=
